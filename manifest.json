{
  "manifest_version": 3,
  "name": "SparkGate",
  "version": "0.1.0",
  "description": "Generador y evaluador de contraseñas con IA",
  "browser_specific_settings": {
    "gecko": {
      "id": "sparkgate@ejemplo.com",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://*.railway.app/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
